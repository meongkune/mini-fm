{
  "family": "induk202212060-pocket-manager",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::925107452037:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "mini-fm",
      "image": "925107452037.dkr.ecr.ap-northeast-2.amazonaws.com/induk202212060-pocket-manager:v1",
      "essential": true,
      "portMappings": [
        { "containerPort": 80, "hostPort": 80, "protocol": "tcp", "name": "http-80" }
      ],
      "environment": [
        { "name": "APP_VERSION", "value": "v1" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/induk202212060-pocket-manager",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
